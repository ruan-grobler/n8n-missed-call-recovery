# Nothing in this file is a secret, and nothing here is needed for "npm run demo".

# ---- Live mode: build workflows with your own settings ----
# npm run build -- --env --out dist/live   writes ready-to-import copies to dist/live (gitignored).
# Any setting in config/default.json can be set as KIT_<NAME IN CAPITALS>. Leave a line out to keep the default.
# Secrets do NOT go here. The Twilio Auth Token, Slack bot token, SMTP password and Postgres password
# go into n8n credentials, where n8n encrypts them.
KIT_BUSINESS_NAME=Harbour Slice
KIT_TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
KIT_TWILIO_FROM=+27000000000
KIT_BOOKING_URL=https://book.example.com/harbour-slice
KIT_TRACKED_LINK_BASE=https://your-n8n.example.com/webhook/hs/book
KIT_NOTIFY_SLACK=true
KIT_SLACK_CHANNEL=#harbour-slice-alerts
KIT_NOTIFY_EMAIL=false
KIT_EMAIL_FROM=alerts@harbourslice.example.com
KIT_EMAIL_TO=manager@harbourslice.example.com
KIT_QUIET_START=21:00
KIT_QUIET_END=08:00

# ---- Local Docker stack (docker-compose.yml) ----
# "npm run e2e" sets these itself with random values for every run. Set them only to run compose by hand,
# for example to stop a stack you kept with "npm run e2e -- --keep".
KIT_DB_PASSWORD=local-only-change-me
KIT_N8N_ENCRYPTION_KEY=local-only-change-me
KIT_N8N_PORT=15678
KIT_MOCK_TWILIO_PORT=14010
KIT_MOCK_SINKS_PORT=14020
